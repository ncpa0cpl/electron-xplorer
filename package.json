{
  "name": "electron-xplorer",
  "version": "1.0.0",
  "private": true,
  "description": "Tabbed file explorer built on Electron and the fs-explorer library",
  "keywords": [],
  "license": "MIT",
  "author": {
    "name": "ncpa0cpl",
    "email": "szymonb21@gmail.com"
  },
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "rm -rf node_modules/.vite && electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "make:deb": "electron-forge make --targets deb",
    "make:rpm": "electron-forge make --targets rpm",
    "make:appimage": "bash scripts/make-appimage.sh",
    "make:macos": "bash scripts/make-macos.sh",
    "lint": "eslint --ext .ts,.tsx .",
    "check": "tsc --noEmit && eslint src --ext .ts,.tsx",
    "test-platform": "node scripts/test-platform.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "resolutions": {
    "@ncpa0cpl/vanilla-jsx": "^0.0.1-alpha.52"
  },
  "dependencies": {
    "@ncpa0cpl/fs-explorer": "^1.0.0",
    "@ncpa0cpl/vanilla-jsx": "^0.0.1-alpha.52",
    "adwavecss": "^0.2.6",
    "adwaveui": "^0.3.2",
    "async-await-queue": "^2.1.4",
    "electron-squirrel-startup": "^1.0.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "mrmime": "^2.0.1",
    "path-browserify": "^1.0.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/ffmpeg-static": "^5.1.0",
    "@types/ffprobe-static": "^2.0.3",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/path-browserify": "^1.0.3",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "dprint": "^0.58.0",
    "electron": "42.5.0",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "typescript": "^7.0.2",
    "vite": "^5.4.21"
  },
  "productName": "Electron Xplorer"
}
