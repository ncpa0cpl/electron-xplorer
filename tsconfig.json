{
  "compilerOptions": {
    "target": "ESNext",
    "module": "commonjs",
    // Vite config files are .mts (ESM, per Forge 8's Vite plugin), so they
    // import vite.shared.mts with an explicit extension. tsc is only ever run
    // with --noEmit here (bundles are produced by Vite/Rollup), which is what
    // allows these extensioned imports.
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "outDir": "dist",
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    // Full strict mode: strictNullChecks, noImplicitAny, strictFunctionTypes,
    // etc. The renderer narrows fs-explorer's `any`-typed controller fields
    // (explorer.location/directory/history, see src/renderer/app.ts) with
    // explicit, commented casts instead of weakening these flags.
    "strict": true,
  },
  "exclude": ["node_modules", ".vite", "out", "dist", "scripts"],
}
